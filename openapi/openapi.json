  "info": {
    "description": "Initial backend-owned API definition for Core Console. Operational endpoints are intentionally excluded.",
    "title": "Core Console API",
    "version": "0.1.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "openapi": "3.1.1",
  "paths": {
    "/helloWorld": {
      "get": {
        "description": "Returns a minimal response used to verify API connectivity.",
        "operationId": "getHelloWorld",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "message": "Hello, world!"
                },
                "schema": {
                  "$ref": "#/components/schemas/HelloWorldResponse"
                }
              }
            },
            "description": "The hello world message was returned successfully."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "internal_error",
                  "detail": "An unexpected error occurred.",
                  "status": 500,
                  "title": "Internal Server Error",
                  "type": "about:blank"
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "An unexpected server error occurred."
          }
        },
        "security": [],
        "summary": "Get the hello world message",
        "tags": [
          "Hello"
        ]
      }
    },
    "/me": {
      "get": {
        "description": "Returns the public profile of the active provisioned user.",
        "operationId": "getCurrentUser",
