# Runtime mode is descriptive for now; it does not enable external services.
APP_ENV=development

# Leave unset until PostgreSQL is available. The explicit psycopg dialect is required.
# Do not copy real credentials into this tracked file.
# DATABASE_URL=postgresql+psycopg://core_console:replace-me@localhost:5432/core_console

DATABASE_CONNECT_TIMEOUT_SECONDS=2.0
