# Runtime mode is descriptive and does not select the authentication mode.
APP_ENV=development

# Development authentication uses one fixed server-side external identity.
AUTH_MODE=development
DEV_IDENTITY_ISSUER=https://identity.example.test
DEV_IDENTITY_SUBJECT=local-developer

# Leave unset until PostgreSQL is available. The explicit psycopg dialect is required.
# Do not copy real credentials into this tracked file.
# DATABASE_URL=postgresql+psycopg://core_console:replace-me@localhost:5432/core_console

DATABASE_CONNECT_TIMEOUT_SECONDS=2.0
